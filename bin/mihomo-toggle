#!/usr/bin/env bash
set -u

# Node names live in the widget conf so a running shell picks up edits
# without a new login. MIHOMO_WIDGET_CONF overrides the path; an empty
# value skips the file so tests stay on the process environment.
load_widget_conf() {
  local file line key value
  if [[ -v MIHOMO_WIDGET_CONF ]]; then
    file=$MIHOMO_WIDGET_CONF
  else
    file=${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/mihomo-widget.conf
  fi
  [[ -n $file && -f $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    [[ $line =~ ^[[:space:]]*(MIHOMO_[A-Z0-9_]+)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    if [[ ${#value} -ge 2 && ( ${value:0:1} == '"' || ${value:0:1} == "'" ) && ${value: -1} == "${value:0:1}" ]]; then
      value=${value:1:${#value}-2}
    fi
    printf -v "$key" '%s' "$value"
    export "$key"
  done < "$file"
}

load_widget_conf

API_DEFAULT="http://127.0.0.1:9090"
GROUP=${MIHOMO_GROUP:-}
GLOBAL_GROUP='GLOBAL'
NODE_A=${MIHOMO_NODE_A:-}
NODE_B=${MIHOMO_NODE_B:-}
NODE_C=${MIHOMO_NODE_C:-}

api=${MIHOMO_API:-$API_DEFAULT}
auth=()
if [[ -n ${MIHOMO_SECRET:-} ]]; then
  auth=(-H "Authorization: Bearer ${MIHOMO_SECRET}")
fi

api_get() {
  curl -s -m 3 --noproxy '*' "${auth[@]+"${auth[@]}"}" "${api%/}$1"
}

api_put() {
  local path=$1 body=$2
  curl -s -m 3 --noproxy '*' -o /dev/null -w '%{http_code}' \
    -X PUT "${auth[@]+"${auth[@]}"}" \
    -H 'Content-Type: application/json' \
    -d "$body" \
    "${api%/}$path"
}

api_patch() {
  local path=$1 body=$2
  curl -s -m 3 --noproxy '*' -o /dev/null -w '%{http_code}' \
    -X PATCH "${auth[@]+"${auth[@]}"}" \
    -H 'Content-Type: application/json' \
    -d "$body" \
    "${api%/}$path"
}

urlencode() {
  jq -rn --arg s "$1" '$s|@uri'
}

fail() {
  jq -cn --arg error "$1" '{ok:false,error:$error}'
  exit 1
}

configured_nodes() {
  local name existing
  NODES=()
  for name in "$NODE_A" "$NODE_B" "$NODE_C"; do
    [[ -n $name ]] || continue
    for existing in "${NODES[@]+"${NODES[@]}"}"; do
      [[ $existing == "$name" ]] && continue 2
    done
    NODES+=("$name")
  done
}

node_in_list() {
  local name=$1 existing
  for existing in "${NODES[@]+"${NODES[@]}"}"; do
    [[ $existing == "$name" ]] && return 0
  done
  return 1
}

cmd=${1:-}
case $cmd in
  node)
    configured_nodes
    (( ${#NODES[@]} >= 1 )) || fail "configure MIHOMO_NODE_A and MIHOMO_NODE_B"
    configs=$(api_get /configs) || fail "configs request failed"
    mode=$(printf '%s' "$configs" | jq -r 'if (.mode | type == "string") then .mode else empty end')
    [[ -n $mode ]] || fail "current mode unavailable"
    case $mode in
      rule) [[ -n $GROUP ]] || fail "configure MIHOMO_GROUP"; group=$GROUP ;;
      global) group=$GLOBAL_GROUP ;;
      direct) fail "direct 模式不支持切换节点" ;;
      *) fail "unsupported mode: $mode" ;;
    esac

    proxies=$(api_get /proxies) || fail "proxies request failed"
    current=$(printf '%s' "$proxies" | jq -r --arg g "$group" '
      if (.proxies | type == "object")
         and (.proxies[$g] | type == "object")
         and (.proxies[$g].type == "Selector")
         and (.proxies[$g].now | type == "string")
      then .proxies[$g].now
      else empty end')
    [[ -n $current ]] || fail "节点组不可用：${group}"
    requested=${2:-}
    if [[ -n $requested ]]; then
      node_in_list "$requested" || fail "node is not configured: $requested"
      target=$requested
    else
      (( ${#NODES[@]} >= 2 )) || fail "configure at least two of MIHOMO_NODE_A, MIHOMO_NODE_B, and MIHOMO_NODE_C"
      target=${NODES[0]}
      for i in "${!NODES[@]}"; do
        if [[ ${NODES[$i]} == "$current" ]]; then
          target=${NODES[$(( (i + 1) % ${#NODES[@]} ))]}
          break
        fi
      done
    fi
    code=$(api_put "/proxies/$(urlencode "$group")" "$(jq -cn --arg name "$target" '{name:$name}')")
    rc=$?
    (( rc == 0 )) || fail "node switch request failed (curl $rc)"
    [[ $code == 204 || $code == 200 ]] || fail "node switch failed (http $code)"
    jq -cn --arg group "$group" --arg from "$current" --arg to "$target" \
      '{ok:true,action:"node",group:$group,from:$from,to:$to}'
    ;;
  mode)
    configs=$(api_get /configs) || fail "configs request failed"
    current=$(printf '%s' "$configs" | jq -r 'if (.mode | type == "string") then .mode else empty end')
    [[ -n $current ]] || fail "current mode unavailable"
    if [[ $current == global ]]; then
      target=rule
    else
      target=global
    fi
    code=$(api_patch /configs "$(jq -cn --arg mode "$target" '{mode:$mode}')")
    rc=$?
    (( rc == 0 )) || fail "mode switch request failed (curl $rc)"
    [[ $code == 204 || $code == 200 ]] || fail "mode switch failed (http $code)"
    jq -cn --arg from "$current" --arg to "$target" '{ok:true,action:"mode",from:$from,to:$to}'
    ;;
  *)
    fail "usage: mihomo-toggle node|mode"
    ;;
esac
